# Copy to .env.local and fill in from Supabase: Project Settings → API.
# The publishable key is safe in the browser. NEVER put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Where this site runs. Used in sign-in emails and Google redirects.
# Must also be listed in Supabase: Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
